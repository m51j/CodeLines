<Window x:Class="CodeLines.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CodeLines — Project Intelligence" Icon="Assets/CodeLines.ico" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources><BooleanToVisibilityConverter x:Key="HistoryVisibility" /></Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource RailBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,28,20,28">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="CL" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CodeLines" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,3" />
                    <TextBlock Text="Project intelligence" Foreground="#94A3B8" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="28,0,0,10" />
                    <Button Style="{StaticResource NavButton}" Content="▦   Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                    <Button Style="{StaticResource NavButton}" Content="▰   Projects" Command="{Binding NavigateCommand}" CommandParameter="Projects" />
                    <Button Style="{StaticResource NavButton}" Content="⌁   Analysis" Command="{Binding NavigateCommand}" CommandParameter="Analysis" />
                    <Button Style="{StaticResource NavButton}" Content="⟳   Code changes" Command="{Binding NavigateCommand}" CommandParameter="Code changes" Visibility="{Binding GitHistoryEnabled, Converter={StaticResource HistoryVisibility}}" />
                    <Button Style="{StaticResource NavButton}" Content="⚙   Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </StackPanel>
                <Border Grid.Row="2" Margin="16" Padding="14" Background="#1E293B" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="LOCAL ANALYSIS" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="No source code leaves this computer." Foreground="#CBD5E1" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPage}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastScanText}" Opacity="0.6" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" Width="210" Margin="0,0,10,0">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding TokenizerOptions}" SelectedItem="{Binding SelectedTokenizer}" Width="135" Margin="0,0,10,0" />
                        <Button Content="Cancel" Command="{Binding CancelActiveAnalysisCommand}" Padding="14,9" Margin="0,0,8,0" />
                        <Button Content="Scan all projects" Style="{StaticResource PrimaryButton}" Command="{Binding ScanAllCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,24,28,18">
                <Grid x:Name="DashboardPage">
                    <Grid.Style>
                        <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <UniformGrid Columns="5">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="PROJECTS" Opacity="0.6" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding TotalProjects, StringFormat=N0}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="FILES" Opacity="0.6" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding TotalFiles, StringFormat=N0}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="PHYSICAL LINES" Opacity="0.6" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding TotalLines, StringFormat=N0}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CODE LINES" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding TotalCodeLines, StringFormat=N0}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{DynamicResource SuccessBrush}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TOKENS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding TotalTokens, StringFormat=N0}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" /></StackPanel></Border>
                    </UniformGrid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,12"><TextBlock Text="Project overview" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Totals for the latest scan" Opacity="0.6" FontSize="12" /></StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="*" />
                                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount, StringFormat=N0}" Width="80" />
                                        <DataGridTextColumn Header="Code" Binding="{Binding CodeLines, StringFormat=N0}" Width="100" />
                                        <DataGridTextColumn Header="Tokens" Binding="{Binding TotalTokens, StringFormat=N0}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,12"><TextBlock Text="Languages" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Select a project to inspect" Opacity="0.6" FontSize="12" /></StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding LanguageRows}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="*" />
                                        <DataGridTextColumn Header="Files" Binding="{Binding Files, StringFormat=N0}" Width="65" />
                                        <DataGridTextColumn Header="Lines" Binding="{Binding PhysicalLines, StringFormat=N0}" Width="90" />
                                        <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat=N0}" Width="95" />
                                        <DataGridTemplateColumn Header="Share" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ProgressBar Value="{Binding PhysicalLines}"
                                                                 Maximum="{Binding DataContext.SelectedResult.PhysicalLines, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 Height="7" Margin="4,0" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="ProjectsPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Projects"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /><RowDefinition Height="170" /></Grid.RowDefinitions>
                    <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Project sources" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Enable, rename, or add folders to the workspace." Opacity="0.65" Margin="0,4,0,0" /></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Command="{Binding ScanSelectedProjectCancelCommand}" Padding="12,9" Margin="0,0,8,0" /><Button Content="Scan selected" Command="{Binding ScanSelectedProjectCommand}" Padding="15,9" Margin="0,0,8,0" /><Button Content="＋ Add project" Style="{StaticResource PrimaryButton}" Click="AddProject_Click" /></StackPanel></DockPanel>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                        <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False" CanUserAddRows="False" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="80" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="210" />
                                <DataGridTextColumn Header="Root path" Binding="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTemplateColumn Header="" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Remove" Command="{Binding DataContext.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,4" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Project exclusions" FontWeight="SemiBold" /><TextBlock Text="One .gitignore-style pattern per line. These are evaluated after repository rules." TextWrapping="Wrap" Opacity="0.65" FontSize="12" Margin="0,8,20,0" /></StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding SelectedProject.Exclusions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="AnalysisPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Analysis"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="8">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Scanned projects" FontSize="17" FontWeight="SemiBold" Margin="10" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" BorderThickness="0">
                                <ListBox.ItemTemplate><DataTemplate><Border Padding="12" Margin="2" CornerRadius="8"><StackPanel><TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" /><TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} files}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" /><TextBlock Text="{Binding Warnings.Count, StringFormat={}{0:N0} warnings}" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="0.42*" /><RowDefinition Height="14" /><RowDefinition Height="0.58*" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Breakdown by language" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" /><DataGrid Grid.Row="1" ItemsSource="{Binding LanguageRows}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="*" /><DataGridTextColumn Header="Category" Binding="{Binding Category, Converter={StaticResource EnumDisplayConverter}}" Width="145" /><DataGridTextColumn Header="Files" Binding="{Binding Files, StringFormat=N0}" Width="75" /><DataGridTextColumn Header="Physical" Binding="{Binding PhysicalLines, StringFormat=N0}" Width="100" /><DataGridTextColumn Header="Code" Binding="{Binding CodeLines, StringFormat=N0}" Width="95" /><DataGridTextColumn Header="Comments" Binding="{Binding CommentLines, StringFormat=N0}" Width="95" /><DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat=N0}" Width="110" /></DataGrid.Columns></DataGrid></Grid></Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="Files" FontSize="17" FontWeight="SemiBold" /><Button Content="Export CSV / JSON" Click="Export_Click" HorizontalAlignment="Right" /></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding FileRows}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="*" /><DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="110" /><DataGridTextColumn Header="Category" Binding="{Binding Category, Converter={StaticResource EnumDisplayConverter}}" Width="135" /><DataGridTextColumn Header="Lines" Binding="{Binding Lines.PhysicalLines, StringFormat=N0}" Width="80" /><DataGridTextColumn Header="Code" Binding="{Binding Lines.CodeLines, StringFormat=N0}" Width="80" /><DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat=N0}" Width="95" /></DataGrid.Columns></DataGrid></Grid></Border>
                    </Grid>
                </Grid>

                <Grid x:Name="HistoryPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CurrentPage}" Value="Code changes" /><Condition Binding="{Binding GitHistoryEnabled}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MinHeight="620" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,12">
                        <TextBlock Text="Last days" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding HistoryPeriods}" SelectedItem="{Binding HistoryPeriod}" Width="100" Margin="0,0,8,0" />
                        <TextBox Text="{Binding CustomHistoryDays, UpdateSourceTrigger=PropertyChanged}" Width="85" Margin="0,0,12,0" ToolTip="Custom period: 1–36500 days"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HistoryPeriod}" Value="Custom"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                        <ComboBox ItemsSource="{Binding HistoryModes}" SelectedItem="{Binding HistoryMode}" Width="155" Margin="0,0,12,0" />
                        <Button Content="Refresh" Command="{Binding RefreshHistoryCommand}" Margin="0,0,8,0" />
                        <Button Content="Cancel" Command="{Binding CancelHistoryCommand}" Margin="0,0,8,0" />
                        <Button Content="Export CSV / JSON" Click="ExportHistory_Click" IsEnabled="{Binding CanExportHistory}" />
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="{Binding HistorySummary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding HistoryTimingText}" Opacity="0.75" Margin="0,3,0,0" />
                        <TextBlock Text="Activity = sum of commits; NetChange = start-to-end difference. Local current branch, first-parent history only." TextWrapping="Wrap" Opacity="0.65" Margin="0,6,0,0" />
                        <TextBlock Text="Modified (est.) overlaps added/deleted totals; do not add it to them. Binary files have no line counts." TextWrapping="Wrap" Opacity="0.65" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <DockPanel Margin="0,0,0,6"><TextBlock Text="{Binding HistoryTotalsText}" FontWeight="SemiBold" /><TextBlock Text="{Binding HistoryTotals.BinaryFiles, StringFormat=Binary files: {0:N0}}" HorizontalAlignment="Right" /></DockPanel>
                        <UniformGrid Columns="6">
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,6,0"><StackPanel><TextBlock Text="ADDED" Opacity="0.65" FontSize="10" /><TextBlock Text="{Binding HistoryTotals.Added, StringFormat=N0}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,6,0"><StackPanel><TextBlock Text="DELETED" Opacity="0.65" FontSize="10" /><TextBlock Text="{Binding HistoryTotals.Deleted, StringFormat=N0}" FontSize="23" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,6,0"><StackPanel><TextBlock Text="MODIFIED (EST.)" Opacity="0.65" FontSize="10" /><TextBlock Text="{Binding HistoryTotals.ModifiedEstimate, StringFormat=N0}" FontSize="23" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,6,0"><StackPanel><TextBlock Text="NET LINES" Opacity="0.65" FontSize="10" /><TextBlock Text="{Binding HistoryTotals.Net, StringFormat=N0}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,6,0"><StackPanel><TextBlock Text="CHANGED FILES" Opacity="0.65" FontSize="10" /><TextBlock Text="{Binding HistoryTotals.ChangedFiles, StringFormat=N0}" FontSize="23" FontWeight="SemiBold" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="12,8"><StackPanel><TextBlock Text="COMMITS (ACTIVITY)" Opacity="0.65" FontSize="10" /><TextBlock Text="{Binding HistoryTotals.Commits, StringFormat=N0, TargetNullValue=—}" FontSize="23" FontWeight="SemiBold" /></StackPanel></Border>
                        </UniformGrid>
                    </StackPanel>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding IsHistoryRunning, Converter={StaticResource HistoryVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding HistoryProgressText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding HistoryProgressText}" />
                            <TextBlock Text="{Binding HistoryWorkText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,3" />
                            <TextBlock Text="{Binding HistoryCurrentPath}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTip="{Binding HistoryCurrentPath}" />
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding HistoryProjectProgress, StringFormat=Current project: {0:F0}%}" FontSize="11" />
                                <ProgressBar Grid.Column="1" Value="{Binding HistoryProjectProgress}" IsIndeterminate="{Binding HistoryProgressIndeterminate}" Maximum="100" Height="6" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProgressValue, StringFormat=Overall (by project): {0:F0}%}" FontSize="11" ToolTip="Projects have equal weight. This percentage does not estimate remaining time." />
                                <ProgressBar Grid.Column="1" Value="{Binding ProgressValue}" Maximum="100" Height="6" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="HistoryProjectGrid" Grid.Row="4" ItemsSource="{Binding HistoryResults}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="150" />
                            <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="110" />
                            <DataGridTextColumn Header="Added" Binding="{Binding Added, StringFormat=N0}" />
                            <DataGridTextColumn Header="Deleted" Binding="{Binding Deleted, StringFormat=N0}" />
                            <DataGridTextColumn Header="Modified (est.)" Binding="{Binding ModifiedEstimate, StringFormat=N0}" />
                            <DataGridTextColumn Header="Net" Binding="{Binding Net, StringFormat=N0}" />
                            <DataGridTextColumn Header="Files" Binding="{Binding ChangedFiles}" />
                            <DataGridTextColumn Header="Binary" Binding="{Binding BinaryFiles}" />
                            <DataGridTextColumn Header="Commits" Binding="{Binding Commits}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="250" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="5" Margin="0,12,0,12"><TextBlock Text="Changed files" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedHistory.Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedHistory.Head, StringFormat=HEAD: {0}}" Opacity="0.65" /></StackPanel>
                    <DataGrid x:Name="HistoryFilesGrid" Grid.Row="6" ItemsSource="{Binding SelectedHistory.Files}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" MinWidth="300" />
                            <DataGridTextColumn Header="Added" Binding="{Binding Added, StringFormat=N0}" Width="90" />
                            <DataGridTextColumn Header="Deleted" Binding="{Binding Deleted, StringFormat=N0}" Width="90" />
                            <DataGridTextColumn Header="Modified (est.)" Binding="{Binding ModifiedEstimate, StringFormat=N0}" Width="130" />
                            <DataGridTextColumn Header="Net" Binding="{Binding Net, StringFormat=N0}" Width="90" />
                            <DataGridCheckBoxColumn Header="Binary" Binding="{Binding Binary}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid></ScrollViewer>
                </Grid>
                <Grid x:Name="SettingsPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Settings"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="850" HorizontalAlignment="Left">
                        <CheckBox Content="Enable Git history statistics" IsChecked="{Binding GitHistoryEnabled}" Margin="0,0,0,16" />
                        <TextBlock Text="Analysis settings" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="These defaults are saved locally and applied to every scan." Opacity="0.65" Margin="0,4,0,20" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Counting scope" FontWeight="SemiBold" /><TextBlock Text="Choose source only, source plus configuration, or every verified text file." TextWrapping="Wrap" Opacity="0.65" Margin="0,6,25,0" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" VerticalAlignment="Top"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tokenizer" FontWeight="SemiBold" /><TextBlock Text="Token counts are calculated entirely offline." TextWrapping="Wrap" Opacity="0.65" Margin="0,6,25,0" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding TokenizerOptions}" SelectedItem="{Binding SelectedTokenizer}" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Appearance" FontWeight="SemiBold" /><TextBlock Text="Follow Windows or force a light or dark Fluent theme." TextWrapping="Wrap" Opacity="0.65" Margin="0,6,25,0" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Maximum file size" FontWeight="SemiBold" /><TextBlock Text="Files larger than this limit are skipped." Opacity="0.65" Margin="0,6,25,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Text="{Binding MaxFileSizeMb}" Width="100" /><TextBlock Text="MB" Margin="10,6,0,0" /></StackPanel></Grid></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Global exclusions" FontWeight="SemiBold" /><TextBlock Text="One .gitignore-style pattern per line." Opacity="0.65" Margin="0,6,25,0" /></StackPanel><TextBox Grid.Column="1" Text="{Binding GlobalExclusions}" AcceptsReturn="True" MinHeight="170" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" /></Grid></Border>
                        <TextBlock Text="{Binding SettingsPath, StringFormat=Settings file: {0}}" Opacity="0.55" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                        <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" />
                    </StackPanel></ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" /><ProgressBar Grid.Column="1" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}" ToolTip="{Binding StatusText}" Maximum="100" Height="5" VerticalAlignment="Center" /></Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
